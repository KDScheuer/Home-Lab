# Home Lab Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored and never committed.
#
# Usage — source before running any IaC:
#   source .env
#   cd terraform && terraform apply
#   cd ansible && ansible-playbook playbooks/site.yml
#
# Rebuild order from scratch:
#   1. source .env
#   2. cd terraform && terraform init && terraform apply
#   3. ansible-playbook ansible/playbooks/rocky_baseline.yml
#   4. ansible-playbook ansible/playbooks/k3s_install.yml
#   5. ansible-playbook ansible/playbooks/tailscale.yml  (then join manually)
# ─────────────────────────────────────────────────────────────────────────────

# ── Proxmox ───────────────────────────────────────────────────────────────────
# API endpoint — any node in the cluster works
export TF_VAR_proxmox_endpoint="https://192.168.50.101:8006"

# API token — format: user@realm!tokenid=secret
# Create in Proxmox UI: Datacenter > Permissions > API Tokens
# Use single quotes to prevent bash from interpreting the ! in the token
export TF_VAR_proxmox_api_token='root@pam!terraform=<your-token-secret>'

# ── SSH ────────────────────────────────────────────────────────────────────────
# Public key is injected into all VMs via cloud-init at provision time
export TF_VAR_ssh_public_key="ssh-ed25519 AAAA..."

# Path to the private key used by Terraform (Proxmox SSH) and Ansible (all VMs)
export TF_VAR_ssh_private_key_path="~/.ssh/ansible"
export ANSIBLE_PRIVATE_KEY_FILE="~/.ssh/ansible"

# ── k3s ───────────────────────────────────────────────────────────────────────
# Shared cluster join token — must match on all control plane and worker nodes
# Generate a value:  openssl rand -hex 32
export K3S_TOKEN="<openssl rand -hex 32>"

# ── AWS ───────────────────────────────────────────────────────────────────────
# Used for DNS-01 certificate challenges (cert-manager) and future backup work
export AWS_ACCESS_KEY_ID="<your-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<your-secret-access-key>"
export AWS_DEFAULT_REGION="us-east-1"

# ── Tailscale ──────────────────────────────────────────────────────────────────
# Tailscale join is intentionally manual — see docs/runbook-tailscale-join.md
# Node: ts1.kds-dev.com (192.168.50.131)
# No auth key is used in automation.
