# Managed by Ansible
# Copy this file to secrets.yml, fill in the values, and keep it local.
# secrets.yml is gitignored and never committed.
#
# Plaintext for homelab simplicity — in production I would use Ansible Vault or a cloud secrets manager, but I don't want that operational overhead here.
---

# Shared k3s cluster join token — must match across all control and worker nodes.
# Used by xanmanning.k3s on secondary control nodes and all workers to join the cluster.
#
# Generate a token:
#   openssl rand -hex 32
k3s_token: ""
